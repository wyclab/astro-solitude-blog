---
import cpa from '../../data/cpa.json';

interface Props {
  title?: string;
  description?: string;
  data?: typeof cpa;
}
const { title = 'CPA 学习看板', description = '', data = cpa } = Astro.props;

const DAY = 86400000;
const isoOf = (ms: number) => new Date(ms).toISOString().slice(0, 10);
const WEEKDAY = ['日', '一', '二', '三', '四', '五', '六'];

const daily = data.daily as Record<string, number>;
const keys = Object.keys(daily).sort();
const refMs = keys.length
  ? Date.parse(`${keys[keys.length - 1]}T00:00:00Z`)
  : Date.now();
const ref = isoOf(refMs);
const shift = (n: number) => refMs + n * DAY;
const minutesOf = (key: string) => daily[key] ?? 0;
const shortDate = (key: string) => `${+key.slice(5, 7)}/${+key.slice(8, 10)}`;
const weekdayOf = (key: string) =>
  WEEKDAY[new Date(`${key}T00:00:00Z`).getUTCDay()];

/* ---- 每日窗口：从首条记录到今天，最多 30 天 ---- */
const firstMs = keys.length ? Date.parse(`${keys[0]}T00:00:00Z`) : refMs;
const spanDays = Math.min(
  30,
  Math.max(7, Math.round((refMs - firstMs) / DAY) + 1),
);
const recent = Array.from({ length: spanDays }, (_, i) => {
  const key = isoOf(shift(i - (spanDays - 1)));
  return {
    key,
    label: shortDate(key),
    weekday: weekdayOf(key),
    minutes: minutesOf(key),
  };
});
const chartMax = Math.max(60, ...recent.map((d) => d.minutes));
const scaleMax = Math.ceil(chartMax / 30) * 30;
const heightPct = (minutes: number) =>
  minutes > 0 ? Math.max(4, (minutes / scaleMax) * 100) : 0;
const goal = data.goalMinutesPerDay;
const goalPct = Math.min(100, (goal / scaleMax) * 100);

/* ---- 汇总 ---- */
const allMinutes = Object.values(daily);
const totalMinutes = allMinutes.reduce((sum, m) => sum + m, 0);
const studyDays = allMinutes.filter((m) => m > 0).length;
const avgMinutes = studyDays ? Math.round(totalMinutes / studyDays) : 0;
const sumRange = (from: number, to: number) => {
  let sum = 0;
  for (let i = from; i <= to; i++) sum += minutesOf(isoOf(shift(i)));
  return sum;
};
const weekMinutes = sumRange(-6, 0);
const hitDays = recent.filter((d) => d.minutes >= goal).length;

/* ---- 连续打卡 ---- */
let streak = 0;
for (let i = 0; i < 400; i++) {
  if (minutesOf(isoOf(shift(-i))) > 0) streak++;
  else break;
}

/* ---- 按月聚合 ---- */
const monthTotals: Record<string, number> = {};
for (const [key, value] of Object.entries(daily)) {
  const month = key.slice(0, 7);
  monthTotals[month] = (monthTotals[month] ?? 0) + value;
}
const monthKeys: string[] = [];
{
  const anchor = new Date(`${ref.slice(0, 7)}-01T00:00:00Z`);
  for (let i = 5; i >= 0; i--) {
    const cursor = new Date(anchor);
    cursor.setUTCMonth(cursor.getUTCMonth() - i);
    monthKeys.push(cursor.toISOString().slice(0, 7));
  }
}
const currentMonth = ref.slice(0, 7);
const previousMonth = monthKeys[monthKeys.length - 2] ?? '';
const monthCurrent = monthTotals[currentMonth] ?? 0;
const monthPrevious = monthTotals[previousMonth] ?? 0;
const last6Months = monthKeys.slice(-6).map((key) => ({
  key,
  label: `${+key.slice(5, 7)}月`,
  minutes: monthTotals[key] ?? 0,
}));
const monthMax = Math.max(60, ...last6Months.map((m) => m.minutes));
const monthScale = Math.ceil(monthMax / 60) * 60;

/* ---- 按季度聚合（近 4 个季度） ---- */
const quarterOf = (key: string) =>
  `${key.slice(2, 4)}Q${Math.floor((+key.slice(5, 7) - 1) / 3) + 1}`;
const quarterTotals: Record<string, number> = {};
for (const [key, value] of Object.entries(daily)) {
  const quarter = quarterOf(key);
  quarterTotals[quarter] = (quarterTotals[quarter] ?? 0) + value;
}
const refYear = +ref.slice(0, 4);
const refQuarterIndex = Math.floor((+ref.slice(5, 7) - 1) / 3);
const quarterKeys: string[] = [];
for (let i = 3; i >= 0; i--) {
  let index = refQuarterIndex - i;
  let year = refYear;
  while (index < 0) {
    index += 4;
    year -= 1;
  }
  quarterKeys.push(`${String(year).slice(2)}Q${index + 1}`);
}
const last4Quarters = quarterKeys.map((key) => ({
  key,
  label: key,
  minutes: quarterTotals[key] ?? 0,
}));
const currentQuarter = quarterKeys[quarterKeys.length - 1];
const previousQuarter = quarterKeys[quarterKeys.length - 2];
const quarterCurrent = quarterTotals[currentQuarter] ?? 0;
const quarterPrevious = quarterTotals[previousQuarter] ?? 0;
const quarterMax = Math.max(60, ...last4Quarters.map((q) => q.minutes));
const quarterScale = Math.ceil(quarterMax / 60) * 60;

/* ---- 热力图（近 12 周，周一为一列起点） ---- */
const heatWeeksCount = 18;
const refDow = (new Date(refMs).getUTCDay() + 6) % 7;
const lastMondayMs = refMs - refDow * DAY;
const heatStartMs = lastMondayMs - (heatWeeksCount - 1) * 7 * DAY;
const heatWeeks = Array.from({ length: heatWeeksCount }, (_, w) =>
  Array.from({ length: 7 }, (_, d) => {
    const ms = heatStartMs + (w * 7 + d) * DAY;
    const key = isoOf(ms);
    return {
      key,
      label: shortDate(key),
      minutes: minutesOf(key),
      future: ms > refMs,
    };
  }),
);
const heatLevel = (minutes: number) =>
  minutes <= 0 ? 0 : minutes <= 30 ? 1 : minutes <= 60 ? 2 : minutes <= 120 ? 3 : 4;
const heatCells = heatWeeks.flat();
const heatPastDays = heatCells.filter((d) => !d.future).length;
const heatDays = heatCells.filter((d) => d.minutes > 0).length;
const heatMinutes = heatCells.reduce((sum, d) => sum + d.minutes, 0);
const heatMiss = heatCells.filter(
  (d) => !d.future && Date.parse(`${d.key}T00:00:00Z`) >= firstMs && d.minutes === 0,
).length;
const heatRange = `${shortDate(isoOf(heatStartMs))} – ${shortDate(ref)}`;

/* ---- 最长连续学习 ---- */
let maxStreak = 0;
{
  let run = 0;
  const daysTotal = Math.round((refMs - firstMs) / DAY) + 1;
  for (let i = 0; i < daysTotal; i++) {
    if (minutesOf(isoOf(firstMs + i * DAY)) > 0) {
      run += 1;
      if (run > maxStreak) maxStreak = run;
    } else run = 0;
  }
}

/* ---- 倒计时 ---- */
const exam = data.exam;
const examMs = Date.parse(`${exam.date}T00:00:00Z`);
const examDays = Math.max(0, Math.ceil((examMs - refMs) / DAY));
const examLabel = `${+exam.date.slice(0, 4)} 年 ${+exam.date.slice(5, 7)} 月 ${+exam.date.slice(8, 10)} 日`;
const endDays = Math.max(
  0,
  Math.ceil((Date.parse(`${exam.challengeEnd}T00:00:00Z`) - refMs) / DAY),
);
const prepDays = Math.round((refMs - firstMs) / DAY) + 1;
const prepTotalDays = Math.max(1, Math.round((examMs - firstMs) / DAY) + 1);
const prepPercent = Math.min(
  100,
  Math.max(0, Math.round((prepDays / prepTotalDays) * 100)),
);

/* ---- 计划 ---- */
const subjects = data.subjects;
const passedCount = subjects.filter((s) => s.status === 'passed').length;
const learningCount = subjects.filter((s) => s.status === 'learning').length;
const planPercent = Math.round((passedCount / Math.max(1, subjects.length)) * 100);
const plan = data.plan;

/* ---- 错题 ---- */
const mistakes = data.mistakes;
const mistakeBookUrl = data.mistakeBook?.url ?? '';
const mistakeBookLabel = data.mistakeBook?.label ?? '错题本';
const mistakeTimes = mistakes.reduce((sum, m) => sum + (m.count ?? 1), 0);
const pendingDetails = mistakes.filter((m) => m.pending).length;
const subjectStats = Object.entries(
  mistakes.reduce<Record<string, number>>((acc, m) => {
    acc[m.subject] = (acc[m.subject] ?? 0) + (m.count ?? 1);
    return acc;
  }, {}),
).sort((a, b) => b[1] - a[1]);
const subjectTop = Math.max(1, ...subjectStats.map(([, n]) => n));

const hours = (minutes: number) => {
  const value = minutes / 60;
  return value >= 100 ? String(Math.round(value)) : value.toFixed(1);
};
const delta = (current: number, previous: number) =>
  previous > 0 ? Math.round(((current - previous) / previous) * 100) : null;
const monthDelta = delta(monthCurrent, monthPrevious);
const quarterDelta = delta(quarterCurrent, quarterPrevious);
const deltaText = (value: number | null) =>
  value === null ? '暂无对比' : `${value > 0 ? '+' : ''}${value}%`;
const deltaClass = (value: number | null) =>
  value === null ? 'is-flat' : value > 0 ? 'is-up' : value < 0 ? 'is-down' : 'is-flat';
const statusText: Record<string, string> = {
  passed: '已完成',
  active: '备考中',
  planned: '未开始',
  learning: '学习中',
  todo: '未开始',
};
---

<div class="cpa" id="cpa">
  <header class="cpa-hero">
    <div class="cpa-hero-text">
      {description && <p class="cpa-kicker">{description}</p>}
      <h1 class="cpa-title">{title}</h1>
      <p class="cpa-hero-meta">
        从 {plan.startYear} 年起，用 {plan.years} 年考完专业阶段与综合阶段
      </p>
    </div>
    <div class="cpa-hero-side">
      <a class="cpa-back" href="/project/"><i class="solitude fas fa-arrow-left" aria-hidden="true"></i>项目列表</a>
      {data.dataStatus === 'sample' && (
        <span class="cpa-badge" title={data.statusNote}>示例数据</span>
      )}
    </div>
  </header>

  <ul class="cpa-kpis">
    <li class="cpa-kpi">
      <span class="cpa-kpi-label">累计学习</span>
      <strong class="cpa-kpi-value">{hours(totalMinutes)}<em>小时</em></strong>
      <span class="cpa-kpi-foot">共 {studyDays} 个学习日</span>
    </li>
    <li class="cpa-kpi">
      <span class="cpa-kpi-label">连续打卡</span>
      <strong class="cpa-kpi-value">{streak}<em>天</em></strong>
      <span class="cpa-kpi-foot">最近记录 {shortDate(ref)}</span>
    </li>
    <li class="cpa-kpi">
      <span class="cpa-kpi-label">通过科目</span>
      <strong class="cpa-kpi-value">{passedCount}<em>/ {subjects.length}</em></strong>
      <span class="cpa-kpi-foot">{learningCount} 科备考中</span>
    </li>
    <li class:list={['cpa-kpi', { 'is-link': Boolean(mistakeBookUrl) }]}>
      {mistakeBookUrl ? (
        <a
          class="cpa-kpi-link"
          href={mistakeBookUrl}
          aria-label={`打开${mistakeBookLabel}：共 ${mistakes.length} 条错题，累计 ${mistakeTimes} 次出错`}
        >
          <span class="cpa-kpi-label">错题条目</span>
          <strong class="cpa-kpi-value">{mistakes.length}<em>条</em></strong>
          <span class="cpa-kpi-foot">累计 {mistakeTimes} 次出错 · 查看{mistakeBookLabel} <i class="solitude fas fa-arrow-right" aria-hidden="true" /></span>
        </a>
      ) : (
        <>
          <span class="cpa-kpi-label">错题条目</span>
          <strong class="cpa-kpi-value">{mistakes.length}<em>条</em></strong>
          <span class="cpa-kpi-foot">累计 {mistakeTimes} 次出错</span>
        </>
      )}
    </li>
  </ul>

  <section class="cpa-card cpa-plan">
    <div class="cpa-card-head">
      <h2><i class="solitude fas fa-route" aria-hidden="true"></i>{plan.title}</h2>
      <span class="cpa-chip">{plan.startYear} — {plan.startYear + plan.years - 1}</span>
    </div>
    <div class="cpa-plan-progress">
      <div class="cpa-plan-progress-head">
        <span>科目通过进度</span>
        <strong>{passedCount} / {subjects.length}</strong>
      </div>
      <div class="cpa-progress" role="img" aria-label={`科目通过 ${planPercent}%`}>
        <span style={`width:${planPercent}%`} />
      </div>
    </div>
    <ol class="cpa-plan-list">
      {plan.targets.map((target) => (
        <li class:list={['cpa-plan-year', `is-${target.status}`]}>
          <div class="cpa-plan-year-head">
            <span class="cpa-plan-year-num">{target.year}</span>
            <span class="cpa-plan-year-tag">{statusText[target.status] ?? target.label}</span>
          </div>
          <ul class="cpa-plan-subjects">
            {target.subjects.map((name) => <li>{name}</li>)}
          </ul>
          {target.note && <p class="cpa-plan-note">{target.note}</p>}
        </li>
      ))}
    </ol>
    <ul class="cpa-subject-grid">
      {subjects.map((subject) => (
        <li class:list={['cpa-subject', `is-${subject.status}`]}>
          <i class="solitude fas fa-circle" aria-hidden="true"></i>
          <span>{subject.name}</span>
          <em>{statusText[subject.status] ?? ''}</em>
        </li>
      ))}
    </ul>
  </section>

  <div class="cpa-grid">
    <section class="cpa-card cpa-chart-card">
      <div class="cpa-card-head">
        <h2><i class="solitude fas fa-chart-simple" aria-hidden="true"></i>每日学习时长</h2>
        <span class="cpa-chip">近 {spanDays} 天</span>
      </div>
      <div class="cpa-chart" style={`--cpa-goal:${goalPct}`}>
        <div class="cpa-chart-goal" aria-hidden="true"><span>{goal} 分钟目标</span></div>
        <div class="cpa-bars">
          {recent.map((day) => (
            <div class="cpa-bar-col">
              <div class="cpa-bar-track">
                <div
                  class:list={[
                    'cpa-bar',
                    {
                      'is-today': day.key === ref,
                      'is-zero': day.minutes === 0,
                      'is-hit': day.minutes >= goal,
                    },
                  ]}
                  style={`height:${heightPct(day.minutes)}%`}
                  data-tip={`${day.label} 周${day.weekday} · ${day.minutes} 分钟`}
                />
              </div>
              <span class="cpa-bar-label">{day.label}</span>
            </div>
          ))}
        </div>
      </div>
      <ul class="cpa-chart-foot">
        <li><span>日均</span><strong>{avgMinutes} 分钟</strong></li>
        <li><span>单日最高</span><strong>{Math.max(...recent.map((d) => d.minutes))} 分钟</strong></li>
        <li><span>达标天数</span><strong>{hitDays} / {spanDays}</strong></li>
      </ul>
    </section>

    <section class="cpa-card cpa-total">
      <div class="cpa-card-head">
        <h2><i class="solitude fas fa-hourglass-half" aria-hidden="true"></i>累计总学习时长</h2>
      </div>
      <p class="cpa-total-value">{hours(totalMinutes)}<span>小时</span></p>
      <p class="cpa-total-sub">约 {Math.round(totalMinutes / 60)} 小时 · 平均每天 {avgMinutes} 分钟</p>
      <ul class="cpa-total-list">
        <li><span>本周</span><strong>{hours(weekMinutes)} 小时</strong></li>
        <li><span>本月</span><strong>{hours(monthCurrent)} 小时</strong></li>
        <li><span>学习日</span><strong>{studyDays} 天</strong></li>
        <li><span>日均</span><strong>{avgMinutes} 分钟</strong></li>
      </ul>
    </section>
  </div>

  <div class="cpa-grid cpa-grid--even">
    <section class="cpa-card cpa-heat">
      <div class="cpa-card-head">
        <h2><i class="solitude fas fa-fire" aria-hidden="true"></i>学习热力图</h2>
        <span class="cpa-chip">近 18 周</span>
      </div>
      <div class="cpa-heat-body">
        <div class="cpa-heat-chart">
          <div class="cpa-heat-grid">
            <div class="cpa-heat-weekdays" aria-hidden="true">
              <span>一</span><span></span><span>三</span><span></span><span>五</span><span></span><span>日</span>
            </div>
            {heatWeeks.map((week) => (
              <div class="cpa-heat-col">
                {week.map((day) => (
                  <div
                    class:list={[
                      'cpa-heat-cell',
                      `is-l${heatLevel(day.minutes)}`,
                      { 'is-future': day.future, 'is-today': day.key === ref },
                    ]}
                    data-tip={day.future ? `${day.label} · 未到` : `${day.label} · ${day.minutes} 分钟`}
                  />
                ))}
              </div>
            ))}
          </div>
          <div class="cpa-heat-foot">
            <span>{heatRange}</span>
            <ul class="cpa-heat-legend" aria-hidden="true">
              <li>少</li>
              <li class="cpa-heat-cell is-l0" />
              <li class="cpa-heat-cell is-l1" />
              <li class="cpa-heat-cell is-l2" />
              <li class="cpa-heat-cell is-l3" />
              <li class="cpa-heat-cell is-l4" />
              <li>多</li>
            </ul>
          </div>
        </div>
        <ul class="cpa-heat-stats">
          <li><span>学习天数</span><strong>{heatDays} 天</strong></li>
          <li><span>热力图时长</span><strong>{hours(heatMinutes)} 小时</strong></li>
          <li><span>最长连续</span><strong>{maxStreak} 天</strong></li>
          <li><span>空档</span><strong>{heatMiss} 天</strong></li>
        </ul>
      </div>
    </section>

    <section class="cpa-card cpa-countdown">
      <div class="cpa-card-head">
        <h2><i class="solitude fas fa-hourglass-end" aria-hidden="true"></i>考试倒计时</h2>
        <span class="cpa-chip">{exam.label}</span>
      </div>
      <p class="cpa-count-value">{examDays}<span>天</span></p>
      <p class="cpa-count-sub">距 {examLabel}（{exam.note}）</p>
      <div class="cpa-count-progress">
        <div class="cpa-plan-progress-head">
          <span>备考时间进度</span>
          <strong>{prepPercent}%</strong>
        </div>
        <div class="cpa-progress" role="img" aria-label={`备考时间进度 ${prepPercent}%`}>
          <span style={`width:${prepPercent}%`} />
        </div>
      </div>
      <ul class="cpa-count-list">
        <li><span>已备考</span><strong>{prepDays} 天</strong></li>
        <li><span>剩余</span><strong>{Math.max(0, prepTotalDays - prepDays)} 天</strong></li>
        <li><span>距挑战收官</span><strong>{endDays} 天</strong></li>
        <li><span>已通过科目</span><strong>{passedCount} / {subjects.length}</strong></li>
      </ul>
    </section>
  </div>

  <section class="cpa-card cpa-compare">
    <div class="cpa-card-head">
      <h2><i class="solitude fas fa-scale-balanced" aria-hidden="true"></i>学习时长对比</h2>
      <span class="cpa-chip">月度 · 季度</span>
    </div>
    <div class="cpa-compare-grid">
      <div class="cpa-compare-block">
        <div class="cpa-compare-block-head">
          <h3>每月对比</h3>
          <span>近 6 个月</span>
        </div>
        <div class="cpa-compare-nums">
          <div class="cpa-compare-cell">
            <span>本月 · {+currentMonth.slice(5, 7)} 月</span>
            <strong>{hours(monthCurrent)}<em>小时</em></strong>
          </div>
          <div class="cpa-compare-cell is-muted">
            <span>上月 · {+previousMonth.slice(5, 7)} 月</span>
            <strong>{hours(monthPrevious)}<em>小时</em></strong>
          </div>
          <span class:list={['cpa-delta', deltaClass(monthDelta)]}>{deltaText(monthDelta)}</span>
        </div>
        <div class="cpa-mini-bars">
          {last6Months.map((month) => (
            <div class="cpa-mini-col">
              <div
                class:list={['cpa-mini-bar', { 'is-today': month.key === currentMonth, 'is-zero': month.minutes === 0 }]}
                style={`height:${month.minutes > 0 ? Math.max(4, (month.minutes / monthScale) * 100) : 0}%`}
                data-tip={`${month.key} · ${hours(month.minutes)} 小时`}
              />
            </div>
          ))}
        </div>
        <ul class="cpa-period-labels">
          {last6Months.map((month) => <li class:list={{ 'is-current': month.key === currentMonth }}>{month.label}</li>)}
        </ul>
      </div>

      <div class="cpa-compare-block">
        <div class="cpa-compare-block-head">
          <h3>每季度对比</h3>
          <span>近 4 个季度</span>
        </div>
        <div class="cpa-compare-nums">
          <div class="cpa-compare-cell">
            <span>本季 · {currentQuarter}</span>
            <strong>{hours(quarterCurrent)}<em>小时</em></strong>
          </div>
          <div class="cpa-compare-cell is-muted">
            <span>上季 · {previousQuarter}</span>
            <strong>{hours(quarterPrevious)}<em>小时</em></strong>
          </div>
          <span class:list={['cpa-delta', deltaClass(quarterDelta)]}>{deltaText(quarterDelta)}</span>
        </div>
        <div class="cpa-mini-bars">
          {last4Quarters.map((quarter) => (
            <div class="cpa-mini-col">
              <div
                class:list={['cpa-mini-bar', { 'is-today': quarter.key === currentQuarter, 'is-zero': quarter.minutes === 0 }]}
                style={`height:${quarter.minutes > 0 ? Math.max(4, (quarter.minutes / quarterScale) * 100) : 0}%`}
                data-tip={`${quarter.key} · ${hours(quarter.minutes)} 小时`}
              />
            </div>
          ))}
        </div>
        <ul class="cpa-period-labels">
          {last4Quarters.map((quarter) => <li class:list={{ 'is-current': quarter.key === currentQuarter }}>{quarter.label}</li>)}
        </ul>
      </div>
    </div>
    <p class="cpa-compare-foot">柱状为各周期总量，高亮为当前月 / 当前季度；上期无记录时不做百分比对比。</p>
  </section>

  <section class="cpa-card cpa-mistakes">
    <div class="cpa-card-head">
      <h2><i class="solitude fas fa-list-check" aria-hidden="true"></i>错题统计</h2>
      <div class="cpa-mistakes-head-actions">
        <span class="cpa-chip">{mistakes.length} 条 · {mistakeTimes} 次</span>
        {mistakeBookUrl && (
          <a class="cpa-book-link" href={mistakeBookUrl}>
            <i class="solitude fas fa-book" aria-hidden="true"></i>{mistakeBookLabel}
            <i class="solitude fas fa-arrow-right" aria-hidden="true"></i>
          </a>
        )}
      </div>
    </div>
    <div class:list={['cpa-mistakes-grid', { 'is-empty': !mistakes.length }]}>
      {mistakes.length > 0 && (
        <div class="cpa-mistakes-side">
          {mistakeBookUrl ? (
            <a
              class="cpa-mistakes-total"
              href={mistakeBookUrl}
              aria-label={`打开${mistakeBookLabel}（累计 ${mistakeTimes} 次出错）`}
            >
              <strong>{mistakeTimes}</strong><span>累计出错次数</span>
            </a>
          ) : (
            <p class="cpa-mistakes-total"><strong>{mistakeTimes}</strong><span>累计出错次数</span></p>
          )}
          <ul class="cpa-mistakes-subjects">
            {subjectStats.map(([name, count]) => (
              <li>
                <span class="cpa-mistakes-subject-name">{name}</span>
                <span class="cpa-mistakes-subject-track">
                  <i style={`width:${Math.round((count / subjectTop) * 100)}%`} />
                </span>
                <span class="cpa-mistakes-subject-count">{count}</span>
              </li>
            ))}
          </ul>
          {pendingDetails > 0 && (
            <p class="cpa-hint"><i class="solitude fas fa-circle-info" aria-hidden="true"></i>{pendingDetails} 条错题详情待录入</p>
          )}
        </div>
      )}

      {mistakes.length ? (
        <ul class="cpa-mistake-list">
          {mistakes.map((item) => {
            const Row = item.url ? 'a' : 'button';
            return (
              <li>
                <Row
                  class="cpa-mistake"
                  href={item.url ?? undefined}
                  type={item.url ? undefined : 'button'}
                  data-cpa-mistake={item.url ? undefined : ''}
                  data-subject={item.subject}
                  data-chapter={item.chapter}
                  data-title={item.title}
                  data-date={item.date}
                  data-count={String(item.count ?? 1)}
                  data-reason={item.reason ?? ''}
                  data-status={item.status ?? ''}
                  data-detail={item.detail ?? ''}
                  data-pending={String(Boolean(item.pending))}
                  aria-label={item.url
                    ? `打开${mistakeBookLabel}查看：${item.title}`
                    : `查看错题详情：${item.title}`}
                >
                  <span class="cpa-mistake-main">
                    <span class="cpa-mistake-title">{item.title}</span>
                    <span class="cpa-mistake-meta">
                      <span class="cpa-mistake-subject">{item.subject}</span>
                      <span>{item.chapter}</span>
                      <span>{shortDate(item.date)}</span>
                    </span>
                  </span>
                  <span class="cpa-mistake-side">
                    <span class:list={['cpa-mistake-status', item.status === '已复习' ? 'is-done' : 'is-todo']}>{item.status}</span>
                    <span class="cpa-mistake-count">×{item.count ?? 1}</span>
                    {item.url
                      ? <i class="solitude fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
                      : <i class="solitude fas fa-chevron-right" aria-hidden="true"></i>}
                  </span>
                </Row>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="cpa-empty">还没有错题记录。录入后点击条目即可查看具体错题详情。</p>
      )}
    </div>
  </section>

  <dialog class="cpa-dialog" id="cpa-mistake-dialog" aria-labelledby="cpa-dialog-title">
    <div class="cpa-dialog-panel">
      <header class="cpa-dialog-head">
        <h3 id="cpa-dialog-title" data-field="title">错题详情</h3>
        <button type="button" class="cpa-dialog-close" data-close aria-label="关闭">
          <i class="solitude fas fa-xmark" aria-hidden="true"></i>
        </button>
      </header>
      <div class="cpa-dialog-meta">
        <span data-field="subject" />
        <span data-field="chapter" />
        <span data-field="date" />
        <span data-field="count" />
        <span data-field="status" />
      </div>
      <dl class="cpa-dialog-body">
        <dt>错误原因</dt>
        <dd data-field="reason" />
        <dt>解题要点</dt>
        <dd data-field="detail" />
      </dl>
      <p class="cpa-dialog-pending" data-field="pending" hidden>
        该错题的详细内容还没录入，补充 <code>src/data/cpa.json</code> 里的 <code>detail</code> 字段后即可显示。
      </p>
    </div>
  </dialog>
</div>

<script>
  const dialog = document.getElementById(
    'cpa-mistake-dialog',
  ) as HTMLDialogElement | null;
  if (dialog) {
    const field = (name: string) =>
      dialog.querySelector<HTMLElement>(`[data-field="${name}"]`);
    const set = (name: string, value?: string) => {
      const node = field(name);
      if (node) node.textContent = value?.trim() ? value : '—';
    };
    const pending = field('pending');

    document.querySelectorAll<HTMLElement>('[data-cpa-mistake]').forEach((row) => {
      row.addEventListener('click', () => {
        const row_data = row.dataset;
        set('title', row_data.title);
        set('subject', row_data.subject);
        set('chapter', row_data.chapter);
        set('date', row_data.date);
        set('count', row_data.count ? `出错 ${row_data.count} 次` : '');
        set('status', row_data.status);
        set('reason', row_data.reason);
        set('detail', row_data.detail);
        if (pending) pending.hidden = row_data.pending !== 'true';
        dialog.showModal();
      });
    });

    dialog.querySelector('[data-close]')?.addEventListener('click', () => {
      dialog.close();
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
